{
  "manifest_version": 3,
  "name": "AutoAcento Digisac",
  "version": "3.0",
  "description": "Corretor e formatador otimizado com protecao de links, exclusivo para Digisac.",
  "permissions": ["activeTab"],
  "icons": {
    "16": "icone.png",
    "48": "icone.png",
    "128": "icone.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["dicts/pt_BR.aff", "dicts/pt_BR.dic"],
      "matches": ["https://uptecnologias.digisac.app/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://uptecnologias.digisac.app/*"],
      "js": ["typo.js", "content.js"]
    }
  ]
}